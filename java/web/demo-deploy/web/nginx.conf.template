worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 256; }

http {
    access_log /dev/stdout;
    client_body_temp_path /tmp/nginx-client-body;
    proxy_temp_path /tmp/nginx-proxy;
    fastcgi_temp_path /tmp/nginx-client-body;
    uwsgi_temp_path /tmp/nginx-client-body;
    scgi_temp_path /tmp/nginx-client-body;
    client_max_body_size 1m;

    server {
        listen ${PORT};
        server_name _;

        location = /health {
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Canteen-Proxy-Secret ${CANTEEN_DEMO_PROXY_SECRET};
            proxy_pass http://127.0.0.1:18080/;
        }

        location / {
            if ($http_x_forwarded_proto != "https") { return 403; }
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Real-IP "";
            proxy_set_header Forwarded "";
            proxy_set_header X-Canteen-Proxy-Secret ${CANTEEN_DEMO_PROXY_SECRET};
            proxy_pass http://127.0.0.1:18080;
        }
    }
}
